{
  "name": "dent-tech-sms",
  "version": "1.0.0",
  "description": "Service Management System - Three Portal (Admin, Technician, Customer) untuk Dent Tech",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i frontend/styles/tailwind.css -o frontend/styles/tailwind.min.css --minify",
    "optimize:landing": "node scripts/optimize-landing.js && npm run build:css",
    "test:api": "powershell -ExecutionPolicy Bypass -File test_api.ps1",
    "test:browser": "node test_browser.js",
    "test:flow": "node test_flow.js",
    "test:portal": "node test_newfeatures.js",
    "test:features": "node test_features2.js",
    "test:visual": "node visual_audit.js",
    "test:finance": "node test_finance.js",
    "test:rupiah": "node test_rupiah.js",
    "test:invoice-sync": "node test_invoice_sync.js",
    "test:wallet": "node test_wallet.js",
    "test:wallet-ui": "node test_wallet_ui.js",
    "audit": "node audit.js",
    "reset": "node reset_db.js"
  },
  "keywords": [
    "service-management",
    "ticketing",
    "work-order",
    "field-service"
  ],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "lucide-static": "0.548.0",
    "tailwindcss": "3.4.17"
  }
}
