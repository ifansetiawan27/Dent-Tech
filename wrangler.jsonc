{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dent-tech",
	"main": "./worker.js",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": true,
	"keep_vars": true,
	"minify": true,
	"assets": {
		"directory": "./frontend",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"run_worker_first": [
			"/api/*"
		]
	},
	"vars": {
		"PAKASIR_PROJECT": "dent-tech",
		"APP_URL": "https://denttech.id"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"placement": {
		"mode": "smart"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "e322d4e81e144ddcbf7912add1d210f8"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "ifansetiawan64@gmail.com"
		}
	]
}
