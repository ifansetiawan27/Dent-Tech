SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
PAKASIR_API_KEY=
PAKASIR_PROJECT=dent-tech

# Web Push (VAPID P-256, format RAW standar web-push):
#   public = raw uncompressed point 65 byte (base64url)
#   private = raw scalar 32 byte (base64url)
# Generate:
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});const spki=k.publicKey.export({type:'spki',format:'der'});const jwk=k.privateKey.export({format:'jwk'});console.log('PUB='+Buffer.from(spki.slice(spki.length-65)).toString('base64url'));console.log('PRIV='+Buffer.from(jwk.d,'base64url').toString('base64url'))"
# Di production Cloudflare Worker, set via: wrangler secret put VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
